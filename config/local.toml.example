# Local secrets + endpoints. NOT checked in.
# Copy to config/local.toml and fill in the values.
#
#     cp config/local.toml.example config/local.toml

[llm]
# OpenAI-compatible endpoint serving multiple model families
# (e.g., a LiteLLM router). The routing config (config/routing_*.yaml)
# selects which model_id to use per (role, tier); that identifier is
# sent as-is to this endpoint, so it must match what the router expects
# (LiteLLM-style "family/model" or bare names, per your router config).
api_base_url = "https://your-router.example.com/v1"
api_key = "sk-..."

[retrieval]
# Web search — any one of these can back the web_search tool. v0 will
# prefer brave > tavily > serper if multiple are set. Set at least one.
#
#   Brave Search — independent web index, Serper-shaped API.
#     Docs: https://brave.com/search/api
#   Tavily — agent-tuned; returns scored pre-chunked content. Good for
#     landscape-survey style "map the terrain" queries.
#     Docs: https://tavily.com
#   Serper — Google-backed web search (2,500/mo free). Closest to "what
#     Google would show you." Docs: https://serper.dev
brave_api_key = ""
# tavily_api_key = ""
# serper_api_key = ""

# Min interval (seconds) between Brave Search calls. The Free tier
# enforces 1 req/s with a strict sliding window; 1.5s leaves headroom.
# Drop this once on a paid plan (~0.05 for 20/s, ~0.02 for 50/s).
# brave_min_interval_s = 1.5

# Semantic Scholar — optional. Unauthenticated access is rate-limited
# but works for small runs.
# semantic_scholar_api_key = ""

# Unpaywall — optional. Unpaywall is public but requires a contact email
# in every request. When set, the academic search pipeline rescues
# paywalled DOI hits to open-access PDFs when available. Leave unset to
# skip the Unpaywall rescue step entirely.
# unpaywall_email = "you@example.com"

[observability]
# Optional Pydantic Logfire token for tracing PydanticAI agent calls.
# logfire_token = ""
